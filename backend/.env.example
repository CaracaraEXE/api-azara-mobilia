# Backend
PORT=3000
API_URL=http://localhost:3000

# Discord (obligatorio para el bot)
DISCORD_PUBLIC_KEY=tu_public_key_aqui
# Se obtiene de: Discord Developer Portal → tu App → General → PUBLIC KEY

# PostgreSQL (Fase 2 de la migración)
# USE_PG=false mantiene la API leyendo los JSON. Cambiar a true recién cuando queries.js esté listo.
USE_PG=false
DATABASE_URL=postgres://azarae_user:password@localhost:5432/azarae_db
